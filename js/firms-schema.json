{
  "_meta": {
    "description": "Schema pre zaznam firmy/specifikacie pre index2 (vz22/vz31/vz34). Hodnoty v ASCII, jednotky v mm, optional polia mozu byt null.",
    "version": "0.2"
  },
  "schema": {
    "firmName": "string - nazov firmy",
    "firmId": "string|null - legacy (volitelne, dnes sa pouziva firmName)",
    "vz": "string - 'vz22' | 'vz31' | 'vz34'",
    "typ": "string - specifikacia (napr. default, A, B...)",
    "notes": "string[] - volne poznamky",
    "techNotes": "string[] - technologicke poznamky",
    "dimensions": {
      "W": "number|null - legacy, zvycajne null",
      "L": "number|null - legacy, zvycajne null",
      "G": "number|null - legacy, zvycajne null",
      "K": "number|null - chlopna",
      "notchLen": "number|null - dlzka zaseku",
      "Cpitch": "number|null - vzdialenost zavesnych otvorov",
      "AxisInK": "number|null - umiestnenie stredu otvorov (z lavej strany chlopne)"
    },
    "clip": {
      "count": "number|null - legacy",
      "offsetX": "number|null - legacy",
      "offsetY": "number|null - legacy",
      "packageCount": "number|null - legacy",
      "type": "string|null - legacy"
    },
    "air": {
      "count": "number|null - pocet vzduchovych otvorov",
      "diameter": "number|null - priemer otvorov",
      "offsetFromEdge": "number|null - vzdialenost od okraja/zalozky",
      "pitch": "number|null - roztec vzduchovych otvorov"
    },
    "perforation": {
      "enabled": "string - 'yes' | 'no' | ''",
      "side": "string - 'lava' | 'prava' | ''",
      "offset": "number|null - vzdialenost od stredu"
    },
    "clipImages": "string[] - ['zhora'] | ['zdola'] | []"
  },
  "example": {
    "firmName": "Demo firma",
    "firmId": "Demo firma",
    "vz": "vz22",
    "typ": "default",
    "notes": [
      "Ukazkova poznamka"
    ],
    "techNotes": [
      "Ukazkova technologicka poznamka"
    ],
    "dimensions": { "W": null, "L": null, "G": null, "K": 45, "notchLen": 7, "Cpitch": 160, "AxisInK": 22 },
    "clip": {
      "count": null,
      "offsetX": null,
      "offsetY": null,
      "packageCount": null,
      "type": null
    },
    "air": { "count": 3, "diameter": 3, "offsetFromEdge": 30, "pitch": 125 },
    "perforation": { "enabled": "yes", "side": "prava", "offset": 7 },
    "clipImages": [
      "zhora"
    ]
  },
  "notes": {
    "important": [
      "Index2 teraz startuje s prazdnym zoznamom firiem.",
      "Firmy sa tvoria manualne cez formular.",
      "Starsie polia (W/L/G/clip legacy) su ponechane pre kompatibilitu."
    ]
  }
}
